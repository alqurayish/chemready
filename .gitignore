# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environment (created by uv, never committed)
.venv/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets: never commit real keys. Only .env.example is shared.
.env
.env.*
!.env.example

# Private factory data: never committed, never sent to a free AI tier.
data/private/
*.sqlite
*.db

# Editors and OS
.vscode/
.idea/
.DS_Store

# Eval data: public SDS PDFs are not redistributed; runs and synthetic files are generated.
evals/pdfs/
evals/runs/
evals/synthetic/

# Local app data (database and uploaded files)
data/
