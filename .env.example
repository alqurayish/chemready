# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is git-ignored. Never commit real keys.

CHEMREADY_ENVIRONMENT=development

# Model provider: "ollama" (local, private files allowed) or "gemini" (cloud).
CHEMREADY_LLM_PROVIDER=ollama

# Ollama runs on your own computer. Its default address is shown below.
CHEMREADY_OLLAMA_BASE_URL=http://localhost:11434
# Pick a model you have pulled with `ollama pull <name>`. Chosen in Phase 5.
CHEMREADY_OLLAMA_MODEL=

# Gemini (public SDS files only while on the free tier).
# Get a key at https://aistudio.google.com/apikey and check the current
# free tier models on https://ai.google.dev/gemini-api/docs/pricing
CHEMREADY_GEMINI_API_KEY=
CHEMREADY_GEMINI_MODEL=
CHEMREADY_GEMINI_FREE_TIER=true

# Storage (data/private/ is git-ignored)
CHEMREADY_DATA_DIR=data
CHEMREADY_DATABASE_PATH=data/private/chemready.sqlite

# Flag SDS files older than this many years (1 to 10)
CHEMREADY_SDS_MAX_AGE_YEARS=3
